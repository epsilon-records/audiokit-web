{
  "name": "audiokit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && python3 -m http.server 8000 -d dist",
    "contract:pull": "node scripts/pull-contract.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:check:strict": "node scripts/check-contract.mjs --strict",
    "test": "node --test test/*.test.mjs",
    "test:build": "npm run build && node test/analytics-output.mjs",
    "test:analytics:browser": "node test/analytics.browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
