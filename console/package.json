{
	"name": "audiokit-console",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "AudioKit customer console — signed-in dashboard, usage, API keys, plan and settings.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:build": "vite build && vitest run --config vitest.build.config.ts",
		"test:storybook": "vitest run --config vitest.storybook.config.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.1",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"storybook": "^10.6.7",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "1.76.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2"
	},
	"overrides": {
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
