{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4174/",
        "http://127.0.0.1:4174/pricing/",
        "http://127.0.0.1:4174/docs/",
        "http://127.0.0.1:4174/docs/reference/",
        "http://127.0.0.1:4174/docs/sdks/",
        "http://127.0.0.1:4174/docs/mcp/",
        "http://127.0.0.1:4174/terms/",
        "http://127.0.0.1:4174/privacy/",
        "http://127.0.0.1:4174/login",
        "http://127.0.0.1:4174/signup"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 275000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(login|signup)$).*$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report/public"
    }
  }
}
