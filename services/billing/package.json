{
  "name": "@audiokit/billing",
  "version": "0.1.0",
  "private": true,
  "description": "AudioKit billing and accounts service: users, subscriptions, API keys, usage and quota",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:migrate": "npm run build && node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
