# AudioKit billing/accounts service — environment template.
# Copy to .env for local development. Never commit a real .env.

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (Railway Postgres in production) ---
DATABASE_URL=postgresql://user:password@localhost:5432/audiokit

# --- JWT (generate with: openssl rand -base64 32) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Application URLs (used for CORS and links) ---
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:8000
CONSOLE_BASE_URL=http://localhost:3001

# --- Security ---
BCRYPT_ROUNDS=10
# Length in bytes used for new API keys.
API_KEY_LENGTH=32

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# --- AudioKit worker (job forwarding is not wired up yet; reserved for that task) ---
AUDIOKIT_WORKER_URL=http://localhost:4000
AUDIOKIT_INTERNAL_SECRET=shared-secret-for-internal-communication

# --- Reserved for the Stripe billing task (decision 0014) ---
# This service does not read or use these yet; do not set them here until the
# Stripe integration lands. Stripe is the approved payment vendor.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO_MONTHLY=
# STRIPE_PRICE_ID_PRO_YEARLY=
